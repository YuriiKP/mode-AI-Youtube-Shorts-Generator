# =============================================================================
# Единый конфиг для всего проекта.
#
# Все ключи необязательны — значения ниже это значения по умолчанию. Флаги
# командной строки перекрывают их на один запуск. Относительные пути считаются
# от каталога, из которого вы запускаете команду.
# =============================================================================

# -----------------------------------------------------------------------------
# Источник и приёмник
# -----------------------------------------------------------------------------
# Что обрабатывать: файл с видео, папка с видео или ссылка на YouTube.
INPUT=input

# -----------------------------------------------------------------------------
# Монтаж (нарезка одного видео в один короткий «хуковый» клип)
# -----------------------------------------------------------------------------
# Режим монтажа: LLM отбирает самые динамичные и связные по смыслу отрезки,
# скрипт вырезает их и склеивает в один ролик длительностью 50–90 секунд, который
# затем идёт дальше по пайплайну (вертикальный кадр, музыка, субтитры) — то есть
# из одного большого видео получается ровно один короткий «хуковый» клип.
#
# Включить можно двумя способами:
#   python main.py montage            # разовая команда
#   MONTAGE_MODE=true                 # тогда её подхватят команды `clip` и `all`
MONTAGE_MODE=false
# Куда писать результат (клипы и обработанные видео).

OUTPUT_DIR=output

# -----------------------------------------------------------------------------
# Нарезка (команды `clip` и `all`)
# -----------------------------------------------------------------------------
# Сколько шортсов сделать.
NUM_CLIPS=1
# Соотношение сторон результата: 9:16 для Shorts/Reels/TikTok, 1:1, 4:5, ...
ASPECT_RATIO=9:11
# Разрешение скачивания исходника: 360 / 480 / 720 / 1080.
DOWNLOAD_FORMAT=720
# Трекинг лица через OpenCV для вертикального кропа (false = статичный центр).
FACE_TRACKING=false

# -----------------------------------------------------------------------------
# LLM (ранжирование моментов) — укажите ключ для вашего провайдера
# -----------------------------------------------------------------------------
# Допустимые значения LLM_PROVIDER: openai | deepseek | gemini
LLM_PROVIDER=deepseek

# Повторы при временных ошибках провайдера (429/5xx/"high demand"/таймаут).
# Задержка между попытками растёт вдвое: LLM_RETRY_BACKOFF, 2x, 4x, ...
LLM_MAX_ATTEMPTS=5
LLM_RETRY_BACKOFF=2

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Двухэтапная генерация разбора: этап 1 — только тайминги, оценка и причина
# виральности; этап 2 — заголовок, теги и метрики по уже отобранным клипам.
TWO_STAGE_ANALYSIS=true

# -----------------------------------------------------------------------------
# Индексация визуала (Visual Indexing)
# -----------------------------------------------------------------------------
# Шаг между транскрибацией и ранжированием: анализирует видеоряд и описывает,
# что происходит на экране (эмоции, действия, объекты, графика). Описания
# подмешиваются в лог для LLM, чтобы она выбирала моменты, где слова
# подкреплены ярким визуальным действием. Без этого шага воркфлоу работает как
# раньше.
VISUAL_INDEXER_ENABLED=true
# Движок: florence — локально (transformers + torch, модель Florence-2),
# gemini_video — облако, весь файл целиком (Files API, до 2 ГБ; «видит»
#   динамику лучше всего),
# qwen_video — локально (transformers + torch, Qwen3.5): видео режется на
#   окна по VISUAL_INDEXER_MAX_SCENE_SECONDS секунд, сэмплирует
#   VISUAL_INDEXER_QWEN_FPS кадров в секунду и описывает окно целиком, возвращая
#   таймлайн сцен — как gemini_video, только по частям, чтобы длинное видео не
#   переполняло контекст модели,
# none — выключено.
VISUAL_INDEXER_TYPE=gemini_video
# Модель для локальных движков (florence / qwen_video); файл скачивается при
# первом запуске. Для florence:
#   microsoft/Florence-2-base      ~0.23B — самая быстрая, мало VRAM;
#   microsoft/Florence-2-base-ft   ~0.23B, дообученная — лучше по описаниям;
#   microsoft/Florence-2-large     ~0.77B — компромисс (значение по умолчанию);
#   microsoft/Florence-2-large-ft  ~0.77B, дообученная — самый детальный
#                                  результат ценой скорости и памяти.
# Суффикс -ft означает дообучение на широком наборе задач: для описания кадров
# такие варианты обычно точнее. base быстрее и легче, large качественнее.
# Для qwen_video — Hugging Face repo id Qwen3.5 (нужен transformers>=4.57).
# Qwen3.5 — единая мультимодальная модель, отдельного суффикса -VL у неё нет:
# зрение встроено в саму модель, поэтому берутся обычные чекпойнты Qwen3.5.
#   Qwen/Qwen3.5-2B   ~2B  — самый лёгкий, ~5 ГБ VRAM в bf16;
#   Qwen/Qwen3.5-4B   ~4B  — значение по умолчанию, ~9 ГБ VRAM в bf16;
#   Qwen/Qwen3.5-9B   ~9B  — заметно точнее, ~19 ГБ VRAM в bf16;
#   Qwen/Qwen3.5-27B  ~27B — лучшие описания, нужна большая VRAM.
# Квантованные сборки — меньше VRAM ценой чуть худших описаний. Готовые
# GPTQ-Int4-репозитории (нужен pip install gptqmodel) есть только для крупных
# размеров:
#   Qwen/Qwen3.5-27B-GPTQ-Int4     Int4 ~27B — ~16 ГБ VRAM;
#   Qwen/Qwen3.5-35B-A3B-GPTQ-Int4 Int4 MoE  — ~20 ГБ VRAM.
# Для остальных размеров квантуйте при загрузке через bitsandbytes
# (VISUAL_INDEXER_QWEN_QUANT=bnb4, нужны bitsandbytes и accelerate).
# GGUF-сборки не подойдут: движок грузит модель через transformers, не llama.cpp.
VISUAL_INDEXER_MODEL=Qwen/Qwen3.5-4B
# Устройство для локальных движков (florence / qwen_video):
# auto (cuda, если доступна) | cpu | cuda.
VISUAL_INDEXER_DEVICE=cuda
# Частота сэмплирования кадров из окна (кадров в секунду); число кадров на один
# запрос = VISUAL_INDEXER_QWEN_FPS × VISUAL_INDEXER_MAX_SCENE_SECONDS.
# ЭТО ЖЕ значение задаёт длину сцены в готовом таймлайне: модель режет окно по
# показанным кадрам, поэтому сцена выходит примерно 1 / VISUAL_INDEXER_QWEN_FPS
# секунд (0.5 → ~2 с, 0.2 → ~5 с, 0.1 → ~7.5 с, ≤0.067 → одна сцена на всё
# 15-секундное окно). VISUAL_INDEXER_MAX_SCENE_SECONDS ограничивает только сам
# запрос, а не сцену.
VISUAL_INDEXER_QWEN_FPS=0.5
# Что уходит в один запрос к qwen_video. Окно всегда собирается по склейкам из
# PySceneDetect и не длиннее VISUAL_INDEXER_MAX_SCENE_SECONDS:
# clip   — кадры, сэмплированные движком с частотой VISUAL_INDEXER_QWEN_FPS,
#          складываются в один видео-элемент: процессор патчит их в
#          видео-токены с временной осью и сам вписывает в промпт метки времени
#          кадров. Декодер для этого не нужен (значение по умолчанию);
# video  — окно режется ffmpeg в mp4 и уходит модели файлом: то же самое, но
#          декодирует его transformers, поэтому нужен torchcodec (или
#          torchvision с read_video) и библиотеки FFmpeg в PATH;
# frames — N отдельных картинок без видео-разметки (старый путь).
VISUAL_INDEXER_QWEN_INPUT=clip
# Сколько секунд видео уходит в один запрос к qwen_video (в один вызов модели).
# Внутри окна модель отдаёт сегменты примерно по VISUAL_INDEXER_MAX_SCENE_SECONDS
# секунд каждый — то есть это ровно длина одной сцены в таймлайне.
# 0 — не паковывать: один запрос = одна сцена. 60 — в один запрос уезжает
# ~4 сцены, и запросов (а значит и времени) становится вчетверо меньше при той
# же длине описания. Меньше длины сцены значение поднимается до неё.
VISUAL_INDEXER_QWEN_REQUEST_SECONDS=0
# Квантование модели qwen_video при загрузке (bitsandbytes):
# off — без квантования; bnb4 — NF4 (≈4x меньше памяти); bnb8 — 8 бит.
# Нужны bitsandbytes и accelerate; для готовых GPTQ-чекпойнтов — off.
VISUAL_INDEXER_QWEN_QUANT=off
# Порог детектора смены сцен (scenedetect, иначе OpenCV fallback); движок florence.
VISUAL_INDEXER_FLORENCE_SCENE_THRESHOLD=27
# Максимальная длина одной сцены в секундах: длинные сцены дробятся, чтобы
# кадры покрывали всё видео. Для qwen_video это длина окна (одного запроса к
# модели) и одновременно длина сцены: на окно приходится ровно одна подпись.
VISUAL_INDEXER_MAX_SCENE_SECONDS=15
# Максимальная высота кадра для визуальной индексации, в пикселях
# (0 — как в исходном видео). Кадры для florence / qwen_video уменьшаются до
# этой высоты перед отправкой в модель; для gemini_video в это
# разрешение перекодируется сам файл перед загрузкой в Gemini Files.
#
# Зачем это нужно:
#   * gemini_video (весь файл) — меньше файл => быстрее загрузка и обработка,
#     но число токенов почти не меняется (облако всё равно пережимает кадры
#     внутри себя до 1 к/сек);
#   * florence / qwen_video (локально) — кадры уходят картинками (Florence сама
#     масштабирует их до 768px), поэтому меньше высота снижает число токенов
#     и расход VRAM.
# Разумные значения: 720 или 480; 0 — не трогать исходное разрешение.
VISUAL_INDEXER_MAX_HEIGHT=480

# -----------------------------------------------------------------------------
# Whisper (распознавание речи)
# -----------------------------------------------------------------------------
# Размер модели (tiny/base/small/medium/large-v3) или путь к локальной модели.
WHISPER_MODEL=large-v3
# auto / cpu / cuda.
WHISPER_DEVICE=cuda
# Код языка (ru, en, ...). Пусто = автоопределение.
WHISPER_LANGUAGE=ru
# Детекция голосовой активности; по умолчанию выключена (агрессивна на музыке).
WHISPER_VAD_FILTER=false

# -----------------------------------------------------------------------------
# Фоновая музыка (команды `music` и `all`)
# -----------------------------------------------------------------------------
# Файл с музыкой ИЛИ папка с треками. Если папка — на каждое видео берётся
# случайный трек.
MUSIC=
# Громкость музыки (1.0 = как в файле). Дорожка речи при этом не меняется.
MUSIC_VOLUME=0.16
# Затухание музыки за последние N секунд (0 — выключено).
MUSIC_FADE_OUT=3

# -----------------------------------------------------------------------------
# Субтитры (команды `subtitles` и `all`)
# -----------------------------------------------------------------------------
# Откуда брать субтитры:
#   auto    -> одноимённый .srt рядом с видео, иначе распознать через Whisper
#   file    -> только одноимённый .srt (или SUBTITLE_FILE); ошибка, если нет
#   whisper -> всегда распознавать через Whisper
#   none    -> субтитры не вшивать
SUBTITLE_SOURCE=auto
# Явный .srt для вшивания (необязательно; перекрывает поиск по имени).
SUBTITLE_FILE=

# Шрифт: файл шрифта, имя файла шрифта для поиска в папке `fonts/` или папка со шрифтами
FONT=fonts\Montserrat-Black.ttf
FONT_SIZE=50
TEXT_FORE_COLOR=#e4e107  # Желтый: #e4e107 Белы: #ffffff Черный: #000000
STROKE_COLOR=#000000
STROKE_WIDTH=3

# Тень под текстом субтитров: false (нет), true (включить тень).
SUBTITLE_SHADOW=true
# Цвет тени (#RRGGBB).
SUBTITLE_SHADOW_COLOR=#000000
# Смещение тени в пикселях по горизонтали и вертикали (можно указывать
# отрицательные значения, чтобы сдвинуть тень влево/вверх).
SUBTITLE_SHADOW_OFFSET_X=5
SUBTITLE_SHADOW_OFFSET_Y=5
# Непрозрачность тени, 0..1 (0 — невидима, 1 — сплошная).
SUBTITLE_SHADOW_OPACITY=0.6
# Размытие тени в пикселях (0 — без размытия); больше — тень мягче.
SUBTITLE_SHADOW_BLUR=3

# Фон субтитров: false (нет), true (чёрный) или цвет #RRGGBB.
TEXT_BACKGROUND_COLOR=false  # Оранжевый #ff3e03
# Форма подложки: true — скруглённый полупрозрачный фон, false — прямой непрозрачный.
SUBTITLE_ROUNDED_BACKGROUND=true
# Вертикальное положение: bottom | top | center | custom.
SUBTITLE_POSITION=center
# Используется при SUBTITLE_POSITION=custom: отступ сверху в процентах (0-100).
CUSTOM_POSITION=72

# Длина одной реплики на экране. Длинные предложения Whisper режутся на короткие
# фразы, каждая появляется и исчезает синхронно с голосом. Реплика разбивается
# ещё раз, если превышает любой из лимитов ниже.
# Максимум символов в реплике.
SUBTITLE_MAX_CHARS=40
# Максимум слов в реплике.
SUBTITLE_MAX_WORDS=2
# Максимум секунд, сколько реплика держится на экране.
SUBTITLE_MAX_DURATION=2
# Анимация появления каждой реплики субтитров. Пусто = без анимации; иначе
# одно из: fade | slide | pop.
SUBTITLE_ANIMATION=slide
# Длительность анимации появления в секундах.
SUBTITLE_ANIMATION_DURATION=0.2
# Сдвиг появления субтитров
SUBTITLE_OFFSET=0.2
# Пауза (в секундах) между двумя словами, при которой начинается новая реплика
# субтитров: субтитр заканчивается на естественной паузе, и текст исчезает с
# экрана во время тишины.
SUBTITLE_PAUSE_THRESHOLD=0.6

# -----------------------------------------------------------------------------
# Вертикальная подгонка (команды `subtitles`, `music` и `all`)
# -----------------------------------------------------------------------------
# Приводить результат к вертикальному кадру. Если видео не совпадает по
# пропорциям, оно вписывается по центру, а пустые места закрывает размытая
# копия этого же видео. Уже вертикальные видео не трогаются.
FIT_VERTICAL=true
# Соотношение сторон вертикального кадра (пусто = взять ASPECT_RATIO из блока нарезки).
FIT_ASPECT_RATIO=9:16
# Высота итогового кадра в пикселях; ширина считается по пропорции (1920 = Full HD).
FIT_HEIGHT=1920
# Сила размытия фона (0 — без размытия).
BACKGROUND_BLUR=30
# Затемнение размытого фона, 0..1 (0 — не затемнять).
BACKGROUND_DARKEN=0

# -----------------------------------------------------------------------------
# Баннер на видео (команды `subtitles`, `music` и `all`)
# -----------------------------------------------------------------------------
# Баннер. Если значение — путь к существующему файлу (PNG с прозрачностью
# или JPG), он рисуется картинкой; любой другой текст — цветной полосой.
BANNER=
# Где разместить баннер: top | bottom | center.
BANNER_POSITION=top
# Ширина картинки баннера как доля ширины кадра (0..1).
BANNER_WIDTH_RATIO=0.9
# Прозрачность картинки баннера (0..1).
BANNER_OPACITY=1.0
# Отступ баннера от края кадра в пикселях.
BANNER_MARGIN=16
# Размер шрифта текстового баннера.
BANNER_FONT_SIZE=48
# Цвет текста и фона текстового баннера.
BANNER_TEXT_COLOR=#FFFFFF
BANNER_BACKGROUND_COLOR=#000000


# -----------------------------------------------------------------------------
# Цветокоррекция и эффекты (команды `subtitles` и `all`)
# -----------------------------------------------------------------------------
# Эффекты применяет движок FFmpeg отдельным быстрым проходом по видео — до
# вшивания субтитров и баннера, поэтому текст остаётся чётким.
# Насыщенность: множитель насыщенности цвета. 1.0 — как в исходнике, 0 — ч/б,
# значения выше 1 делают цвет ярче.
SATURATION=1.8
# Резкость: сила нерезкого маскирования, 0 отключает (1.0 — мягко, 2.0 — сильно).
SHARPNESS=0.8
# Хроматические аберрации: сдвиг красного и синего каналов в противоположные
# стороны на N пикселей (цветная «каёмка» на контурах). 0 отключает эффект.
CHROMATIC_ABERRATION=1.8
# Скорость воспроизведения: 1 — обычная скорость, 1.5 — на 50% быстрее,
# 0.5 — вдвое медленнее. Ускоряется (или замедляется) и видео, и звук — в том
# же быстром проходе, что и цветокоррекция, поэтому звук не «отстаёт» от
# картинки, а субтитры остаются синхронными.
SPEED=1.1


# -----------------------------------------------------------------------------
# Уникализация — обход детекции дубликатов (команды `subtitles` и `all`)
# -----------------------------------------------------------------------------
# Площадки сравнивают ролики не только побайтово, но и по «перцептивному»
# отпечатку кадра и по звуку. Эти почти незаметные правки сдвигают все три
# отпечатка (байтовый, кадровый и звуковой). Применяет их тот же быстрый проход
# FFmpeg, что и цветокор, — до вшивания субтитров, поэтому текст остаётся чётким.

# Зеркало по горизонтали (hflip). Самый сильный сдвиг кадрового хеша, но
# переворачивает текст и надписи, которые есть в самом видео.
# Булев флаг: UNIQUE_RANDOMIZE его не меняет (как UNIQUE_LOUDNESS и UNIQUE_METADATA).
UNIQUE_MIRROR=false
# Микро-обрезка: сколько пикселей убрать с каждого края кадра, после чего
# картинка растягивается обратно до исходного размера (лёгкий «наезд»).
# 0 — выключено; 3-8 — незаметно. Один из самых эффективных приёмов.
UNIQUE_CROP=4
# Зернистость: временной шум на каждый кадр, 0..100. 0 — выключено; 3-5 —
# практически незаметно, но заметно сдвигает перцептивный хеш.
UNIQUE_NOISE=12
# Тон: яркость (-1..1), контраст и гамма (1.0 — как в исходнике).
UNIQUE_BRIGHTNESS=0
UNIQUE_CONTRAST=1.03
UNIQUE_GAMMA=1.0
# Поворот оттенка в градусах (-180..180). 0 — выключено.
UNIQUE_HUE=1
# Микро-сдвиг высоты звука в процентах (длительность и синхронизация не
# меняются — сдвигается только тембр, а с ним и аудио-отпечаток).
UNIQUE_PITCH=0.5
# Нормализация громкости по стандарту площадок (переписывает форму волны).
# Булев флаг: UNIQUE_RANDOMIZE его не меняет.
UNIQUE_LOUDNESS=false
# Дополнительный сдвиг громкости в дБ (0 — без изменений).
UNIQUE_GAIN=0
# В конце рендера стереть метаданные контейнера (устройство, GPS, дата,
# кодировщик) и вписать свежий уникальный комментарий — меняет байтовый хеш
# файла без пере-кодирования.
# Булев флаг: UNIQUE_RANDOMIZE его не меняет.
UNIQUE_METADATA=true
# Рандомизация: перед каждым рендером ЧИСЛОВЫЕ параметры уникализации слегка
# разбрасываются, поэтому каждый ролик получается отдельным вариантом (удобно
# при публикации одного клипа на много аккаунтов).
# Разбрасываются (амплитуда указана для UNIQUE_JITTER=1, фактический разброс =
# амплитуда × UNIQUE_JITTER): UNIQUE_CROP ±4px (0..12), UNIQUE_NOISE ±3 (0..10),
# UNIQUE_BRIGHTNESS ±0.02 (-0.1..0.1), UNIQUE_CONTRAST ±0.03 (0.8..1.2),
# UNIQUE_GAMMA ±0.03 (0.8..1.2), UNIQUE_HUE ±3° (-8..8), UNIQUE_PITCH ±0.5% (-2..2).
# НЕ меняются: UNIQUE_MIRROR, UNIQUE_LOUDNESS, UNIQUE_METADATA и все прочие
# эффекты (SATURATION, SHARPNESS, CHROMATIC_ABERRATION, SPEED).
UNIQUE_RANDOMIZE=false
# Амплитуда разброса при UNIQUE_RANDOMIZE (0..1); умножается на амплитуды выше
# (0.5 — половина разброса, 1 — полный).
UNIQUE_JITTER=0.5


# ---------------------------------------------------------------------------
# Скольжение по кадру между переходами (монтажный эффект на этапе нарезки)
# ---------------------------------------------------------------------------
# Включает эффект «скольжения»: окно вертикальной обрезки плавно едет по
# широкому исходному кадру — вправо, затем влево, и так поочерёдно на каждом
# переходе (склейке/фейде) внутри уже нарезанного клипа. Так как края широкого
# кадра обрезаются, скольжение «показывает» скрытые части картинки и добавляет
# немного движения. Эффект применяется на самом первом этапе — при нарезке
# клипа, до цветовых эффектов, субтитров и баннера.
# false — выключено (по умолчанию), true — включено.
SLIDE_EFFECT=true
# Переходы, отстоящие друг от друга меньше чем на это число секунд,
# объединяются в одну группу, и скольжение выполняется сразу через всю группу,
# а не начинается заново на каждой склейке. За счёт группировки каждое
# скольжение длится минимум это число секунд (переходы, до которых от начала
# или до конца клипа остаётся меньше, просто пропускаются).
SLIDE_TRANSITION_GAP=3.5
# Доля от полного горизонтального хода окна обрезки (от 1 до 0).
# 1 — окно проезжает от самого края широкого кадра до противоположного
#     (весь доступный ход, как было раньше);
# 0 — движения нет: граница хода настолько мала, что окно стоит по центру;
# промежуточные значения оставляют одинаковый отступ от обоих краёв, до
# которых может уезжать кадр.
SLIDE_RANGE=0.85


# -----------------------------------------------------------------------------
# Кодирование
# -----------------------------------------------------------------------------
# По умолчанию libx264; для аппаратного кодирования попробуйте h264_nvenc /
# h264_qsv / h264_amf.
VIDEO_CODEC=h264_nvenc
AUDIO_CODEC=aac
AUDIO_BITRATE=192k
# Скорость/размер x264/x265: ultrafast..veryslow. "medium" (дефолт MoviePy) —
# самый медленный из разумных; "fast"/"veryfast" кодируют в разы быстрее.
PRESET=fast
# Частота кадров результата; 0 — как в исходнике.
FPS=0
# Потоки кодировщика; 0 — использовать все доступные ядра (быстрее всего).
THREADS=0
# Путь к ffmpeg (пусто = автоопределение из PATH / imageio-ffmpeg).
FFMPEG_PATH=


# =============================================================================
# Публикация на YouTube / TikTok (команда `publish`)
# =============================================================================
# Команда `publish` загружает готовые клипы на YouTube (Studio) и TikTok
# (Studio) автоматизацией браузера. Куки/логины хранятся в именованных
# браузерных профилях — один профиль держит сразу и YouTube, и TikTok.
# Авторизация: python main.py publish manual --profile profile_1
# Документация: раздел "Публикация" в README.md.

# -----------------------------------------------------------------------------
# Распределение клипов по профилям
# -----------------------------------------------------------------------------
PUBLISH_SHARDX_API_TOKEN=
# distribute — клипы раздаются по профилям по кругу (по одному на профиль),
#              публикация сразу;
# schedule   — то же распределение, но каждый клип встаёт в расписание.
PUBLISH_MODE=schedule
# Даты-время публикации (только для PUBLISH_MODE=schedule). Формат ISO, через
# запятую; сколько значений — столько клипов публикует КАЖДЫЙ профиль (значение
# r — время r-го клипа этого профиля). Время — в часовом поясе канала.
# Пример: PUBLISH_SCHEDULE=2026-04-01T06:00,2026-04-01T12:00
PUBLISH_SCHEDULE=2026-10-07T06:00

# --- Профили и вывод ---------------------------------------------------------
# Каталог с браузерными профилями (внесён в .gitignore).
PUBLISH_PROFILE_DIR=browser_profiles
# Файл SQLite с историей загрузок и защитой от повторной публикации.
PUBLISH_DB=publish_state.sqlite3
# Откуда брать клипы и shorts_info.json (совпадает с OUTPUT_DIR выше).
PUBLISH_OUTPUT_DIR=output

# --- Браузер (общее) ---------------------------------------------------------
# Загружать без окна браузера. Для загрузки лучше false — окно не даёт
# оборвать передачу файла на середине.
PUBLISH_HEADLESS=false
# Прокси для всех запусков, например http://127.0.0.1:7890 (нужен, если
# youtube.com / tiktok.com недоступны напрямую). Пусто — без прокси.
# В режиме shardx прокси привязывается к профилю ShardX.
PUBLISH_PROXY=

# --- Настройки движка shardx -------------------------------------------------
# id шаблона отпечатка из библиотеки (win-rtx4060, mac-m1-air13, linux-gtx1050,
# ...); пусто -> случайный шаблон платформы PUBLISH_SHARDX_PLATFORM.
PUBLISH_SHARDX_TEMPLATE=
# платформа для случайного шаблона: Windows | macOS | Linux (пусто -> хост).
PUBLISH_SHARDX_PLATFORM=Windows
# каталог кэша SDK (движок + профили); пусто -> каталог SDK по умолчанию
# (%LOCALAPPDATA%\shardx-sdk на Windows).
PUBLISH_SHARDX_CACHE_DIR=
# стратегия экрана: profile | cap_to_host | use_host (пусто -> автовыбор).
PUBLISH_SHARDX_SCREEN_MODE=
# пере-рандомизировать железо (CPU/RAM/версия платформы) перед запуском.
PUBLISH_SHARDX_RANDOMIZE=false
# шумовые векторы через запятую: canvas,webgl,audio,client_rects,sensors,fonts.
PUBLISH_SHARDX_NOISE=
# политика WebRTC: auto | tcp_only | block.
PUBLISH_SHARDX_WEBRTC=auto
# язык браузера (BCP-47): en-US | ru-RU | пусто/auto (тогда SDK выведет его из
# гео). Часовой пояс и гео всё равно берутся из гео.
PUBLISH_SHARDX_LANGUAGE=en-US

# --- Постинг -----------------------------------------------------------------
# Хэштеги по умолчанию для клипов, у которых нет своих тегов (из LLM).
PUBLISH_TAGS=anime,аниме,shorts,animeedit
# Видимость видео на YouTube: public | unlisted | private.
PUBLISH_VISIBILITY=public
# Необязательный плейлист YouTube: видео добавляется в него (создаётся при
# необходимости). Пусто — не добавлять.
PUBLISH_YT_PLAYLIST=
# Пауза между двумя загрузками, в секундах (чтобы не ловить лимиты площадок).
PUBLISH_DELAY=30
