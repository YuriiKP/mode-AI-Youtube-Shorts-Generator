# =============================================================================
# Единый конфиг для всего проекта.
#
# Все ключи необязательны — значения ниже это значения по умолчанию. Флаги
# командной строки перекрывают их на один запуск. Относительные пути считаются
# от каталога, из которого вы запускаете команду.
# =============================================================================

# -----------------------------------------------------------------------------
# Источник и приёмник
# -----------------------------------------------------------------------------
# Что обрабатывать: файл с видео, папка с видео или ссылка на YouTube.
INPUT=input
# Куда писать результат (клипы и обработанные видео).
OUTPUT_DIR=output

# -----------------------------------------------------------------------------
# Нарезка (команды `clip` и `all`)
# -----------------------------------------------------------------------------
# Сколько шортсов сделать.
NUM_CLIPS=3
# Соотношение сторон результата: 9:16 для Shorts/Reels/TikTok, 1:1, 4:5, ...
ASPECT_RATIO=9:16
# Разрешение скачивания исходника: 360 / 480 / 720 / 1080.
DOWNLOAD_FORMAT=720
# Трекинг лица через OpenCV для вертикального кропа (false = статичный центр).
FACE_TRACKING=true

# -----------------------------------------------------------------------------
# LLM (ранжирование моментов) — укажите ключ для вашего провайдера
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Whisper (распознавание речи)
# -----------------------------------------------------------------------------
# Размер модели (tiny/base/small/medium/large-v3) или путь к локальной модели.
WHISPER_MODEL=base
# auto / cpu / cuda.
WHISPER_DEVICE=auto
# Код языка (ru, en, ...). Пусто = автоопределение.
WHISPER_LANGUAGE=
# Детекция голосовой активности; по умолчанию выключена (агрессивна на музыке).
WHISPER_VAD_FILTER=false

# -----------------------------------------------------------------------------
# Фоновая музыка (команды `music` и `all`)
# -----------------------------------------------------------------------------
# Файл с музыкой ИЛИ папка с треками. Если папка — на каждое видео берётся
# случайный трек.
MUSIC=music
# Громкость музыки (1.0 = как в файле). Дорожка речи при этом не меняется.
MUSIC_VOLUME=0.2
# Затухание музыки за последние N секунд (0 — выключено).
MUSIC_FADE_OUT=3

# -----------------------------------------------------------------------------
# Субтитры (команды `subtitles` и `all`)
# -----------------------------------------------------------------------------
# Откуда брать субтитры:
#   auto    -> одноимённый .srt рядом с видео, иначе распознать через Whisper
#   file    -> только одноимённый .srt (или SUBTITLE_FILE); ошибка, если нет
#   whisper -> всегда распознавать через Whisper
#   none    -> субтитры не вшивать
SUBTITLE_SOURCE=auto
# Явный .srt для вшивания (необязательно; перекрывает поиск по имени).
SUBTITLE_FILE=

# Шрифт: файл шрифта, имя файла шрифта для поиска в папке `fonts/` или папка со шрифтами
FONT=fonts\Montserrat-Black.ttf
FONT_SIZE=80
TEXT_FORE_COLOR=#ffffff  # Желтый: #e4e107 Белы: #ffffff Черный: #000000
STROKE_COLOR=#000000
STROKE_WIDTH=3
# Фон субтитров: false (нет), true (чёрный) или цвет #RRGGBB.
TEXT_BACKGROUND_COLOR=#ff3e03  # Оранжевый #ff3e03
ROUNDED_SUBTITLE_BACKGROUND=false
# Вертикальное положение: bottom | top | center | custom.
SUBTITLE_POSITION=custom
# Используется при SUBTITLE_POSITION=custom: отступ сверху в процентах (0-100).
CUSTOM_POSITION=75

# Длина одной реплики на экране. Длинные предложения Whisper режутся на короткие
# фразы, каждая появляется и исчезает синхронно с голосом. Реплика разбивается
# ещё раз, если превышает любой из лимитов ниже.
# Максимум символов в реплике.
SUBTITLE_MAX_CHARS=40
# Максимум слов в реплике.
SUBTITLE_MAX_WORDS=2
# Максимум секунд, сколько реплика держится на экране.
SUBTITLE_MAX_DURATION=2
# Анимация появления каждой реплики субтитров. Пусто = без анимации; иначе
# одно из: fade | slide | pop.
SUBTITLE_ANIMATION=slide
# Длительность анимации появления в секундах.
SUBTITLE_ANIMATION_DURATION=0.2
# Сдвиг появления субтитров
SUBTITLE_OFFSET=0.2
# Пауза (в секундах) между двумя словами, при которой начинается новая реплика
# субтитров: субтитр заканчивается на естественной паузе, и текст исчезает с
# экрана во время тишины.
SUBTITLE_PAUSE_THRESHOLD=0.6


# -----------------------------------------------------------------------------
# Вертикальная подгонка (команды `subtitles`, `music` и `all`)
# -----------------------------------------------------------------------------
# Приводить результат к вертикальному кадру. Если видео не совпадает по
# пропорциям, оно вписывается по центру, а пустые места закрывает размытая
# копия этого же видео. Уже вертикальные видео не трогаются.
FIT_VERTICAL=true
# Соотношение сторон вертикального кадра (пусто = взять ASPECT_RATIO из блока нарезки).
FIT_ASPECT_RATIO=9:16
# Высота итогового кадра в пикселях; ширина считается по пропорции (1920 = Full HD).
FIT_HEIGHT=1920
# Сила размытия фона (0 — без размытия).
BACKGROUND_BLUR=30
# Затемнение размытого фона, 0..1 (0 — не затемнять).
BACKGROUND_DARKEN=0

# -----------------------------------------------------------------------------
# Баннер на видео (команды `subtitles`, `music` и `all`)
# -----------------------------------------------------------------------------
# Баннер. Если значение — путь к существующему файлу (PNG с прозрачностью
# или JPG), он рисуется картинкой; любой другой текст — цветной полосой.
BANNER=
# Где разместить баннер: top | bottom | center.
BANNER_POSITION=top
# Ширина картинки баннера как доля ширины кадра (0..1).
BANNER_WIDTH_RATIO=0.9
# Прозрачность картинки баннера (0..1).
BANNER_OPACITY=1.0
# Отступ баннера от края кадра в пикселях.
BANNER_MARGIN=16
# Размер шрифта текстового баннера.
BANNER_FONT_SIZE=48
# Цвет текста и фона текстового баннера.
BANNER_TEXT_COLOR=#FFFFFF
BANNER_BACKGROUND_COLOR=#000000


# -----------------------------------------------------------------------------
# Цветокоррекция и эффекты (команды `music`, `subtitles` и `all`)
# -----------------------------------------------------------------------------
# Эффекты применяет движок FFmpeg отдельным быстрым проходом по видео — до
# вшивания субтитров и баннера, поэтому текст остаётся чётким.
# Насыщенность: множитель насыщенности цвета. 1.0 — как в исходнике, 0 — ч/б,
# значения выше 1 делают цвет ярче.
SATURATION=1.0
# Резкость: сила нерезкого маскирования, 0 отключает (1.0 — мягко, 2.0 — сильно).
SHARPNESS=0
# Хроматические аберрации: сдвиг красного и синего каналов в противоположные
# стороны на N пикселей (цветная «каёмка» на контурах). 0 отключает эффект.
CHROMATIC_ABERRATION=0


# -----------------------------------------------------------------------------
# Кодирование
# -----------------------------------------------------------------------------
# По умолчанию libx264; для аппаратного кодирования попробуйте h264_nvenc /
# h264_qsv / h264_amf.
VIDEO_CODEC=h264_nvenc
AUDIO_CODEC=aac
AUDIO_BITRATE=192k
# Скорость/размер x264/x265: ultrafast..veryslow. "medium" (дефолт MoviePy) —
# самый медленный из разумных; "fast"/"veryfast" кодируют в разы быстрее при
# почти незаметной потере качества.
PRESET=fast
# Частота кадров результата; 0 — как в исходнике.
FPS=0
# Потоки кодировщика; 0 — использовать все доступные ядра (быстрее всего).
THREADS=0
# Путь к ffmpeg (пусто = автоопределение из PATH / imageio-ffmpeg).
FFMPEG_PATH=
